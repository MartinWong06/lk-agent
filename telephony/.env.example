# LiveKit Cloud / self-host (agent workers + SIP API)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit SIP endpoint host — project_id WITHOUT the p_ prefix + .sip.livekit.cloud
# Example: project_id p_25v23ne9zzm → 25v23ne9zzm.sip.livekit.cloud
# (Often DIFFERENT from the wss:// subdomain.)
LIVEKIT_SIP_HOST=
# DID / routing number configured on the LiveKit inbound trunk (must match exactly)
LIVEKIT_DID=+15555550100
LIVEKIT_SIP_USERNAME=asterisk-trunk
LIVEKIT_SIP_PASSWORD=change-me-trunk-password
# Public egress IP Asterisk puts in LiveKit-facing SIP Contact / SDP
EXTERNAL_SIP_IP=
# Comma-separated IPs LiveKit should accept (include EXTERNAL_SIP_IP + observed NATs)
SIP_ALLOWED_ADDRESSES=
# Docker Desktop Windows/macOS softphone (ICE + mic):
# Run: powershell -File scripts/bringup-windows.ps1
# Then open https://<LAN_IP>:8443/ (accept self-signed cert) — NOT localhost / NOT plain http
SOFTPHONE_PUBLIC_HOST=
SOFTPHONE_MEDIA_IP=
SOFTPHONE_WS_SERVER=
SOFTPHONE_ENABLE_HTTPS=1
# Optional TURN relay, only for browsers NOT on the same LAN as Docker.
# LAN browsers reach Asterisk RTP directly (Asterisk advertises SOFTPHONE_MEDIA_IP).
# Enable: SOFTPHONE_TURN=1 and `docker compose --profile turn up -d`
SOFTPHONE_TURN=0
TURN_USER=softphone
TURN_PASSWORD=change-me-turn

# Softphone demo user (registers via Kamailio → Asterisk; Kamailio enforces digest auth)
SIP_DOMAIN=voice.local
SOFTPHONE_USER=1001
SOFTPHONE_PASSWORD=change-me-softphone
# Extra SIP accounts for Kamailio "user:pass,user2:pass2" (empty = just SOFTPHONE_USER).
# Passwords must not contain " \ or $.
SIP_USERS=
AI_EXTENSION=1000

# --- Production / VPS (scripts/vps-setup.sh fills these) ---
# 1 = refuse change-me / <12 char passwords, hide SIP password from config.json
#     (users log in on the page), no SIP trace, HTTPS redirect + HSTS
PRODUCTION=0
# HTTP basic auth in front of the softphone page (recommended on the internet)
SOFTPHONE_BASIC_AUTH_USER=
SOFTPHONE_BASIC_AUTH_PASSWORD=
# 1 = publish the SIP password in config.json even when PRODUCTION=1 (not recommended)
SOFTPHONE_EMBED_CREDENTIALS=
# Cost guards for the LiveKit leg: concurrent AI calls, max seconds per call
MAX_AI_CALLS=5
MAX_CALL_SECONDS=900
# Pin the Asterisk base image (default andrius/asterisk:23)
ASTERISK_IMAGE=

# Path mounted into agent workers
AGENT_CONFIG=/config/agent.yaml
AGENT_NAME=enterprise-voice
