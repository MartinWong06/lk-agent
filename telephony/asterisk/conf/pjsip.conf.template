; Generated at container start from env — do not edit the live file by hand.
; Softphone registers on Kamailio; Kamailio dispatches INVITE to Asterisk.
;
; IMPORTANT (Docker Desktop softphone audio):
; Do NOT put EXTERNAL_SIP_IP on transport-udp. That rewrites softphone WebRTC SDP
; to the WAN address and breaks browser↔Asterisk ICE (remote track stays muted).
; LiveKit uses transport-tcp, which keeps EXTERNAL_SIP_IP for Cloud SIP/RTP.

[global]
type=global
; Prefer IP identify for Kamailio-sourced INVITEs (no Asterisk registration)
endpoint_identifier_order=ip,username,anonymous

; Local/Kamailio UDP — no external_* so endpoint media_address (LAN) wins in SDP
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

; LiveKit SIP trunk — advertise public egress for Cloud Contact/SDP
[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=__EXTERNAL_SIP_IP__
external_signaling_address=__EXTERNAL_SIP_IP__

; ---------- Trusted Kamailio edge (WebRTC SDP from browser) ----------
; INVITE source is Kamailio container IP, not the browser. Match Docker/LAN
; ranges so we do not require digest auth on the Asterisk hop.
[from-kamailio]
type=endpoint
context=from-internal
transport=transport-udp
disallow=all
allow=ulaw,alaw,opus
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
; webrtc=yes enables ice/dtls/avpf/rtcp_mux + media_use_received_transport
webrtc=yes
dtls_auto_generate_cert=yes
dtls_verify=no
dtls_setup=actpass
; Browser-reachable host LAN IP (Docker publishes RTP ports to this address)
media_address=__SOFTPHONE_MEDIA_IP__

[identify-kamailio]
type=identify
endpoint=from-kamailio
match=172.16.0.0/12
match=10.0.0.0/8
match=192.168.0.0/16
match=127.0.0.1/32

; ---------- Softphone user endpoint (optional direct / username match) ----------
; No auth= here: Kamailio already authenticated REGISTER; challenging INVITE
; from the proxy caused 401 + "No matching endpoint" when username match failed.
[__SOFTPHONE_USER__]
type=endpoint
context=from-internal
transport=transport-udp
disallow=all
allow=ulaw,alaw,opus
aors=__SOFTPHONE_USER__
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
webrtc=yes
dtls_auto_generate_cert=yes
dtls_verify=no
dtls_setup=actpass
media_address=__SOFTPHONE_MEDIA_IP__

[__SOFTPHONE_USER__]
type=auth
auth_type=userpass
username=__SOFTPHONE_USER__
password=__SOFTPHONE_PASSWORD__

[__SOFTPHONE_USER__]
type=aor
max_contacts=5
remove_existing=yes
qualify_frequency=60

; ---------- LiveKit SIP trunk (outbound from Asterisk) ----------
[livekit-auth]
type=auth
auth_type=userpass
username=__LIVEKIT_SIP_USERNAME__
password=__LIVEKIT_SIP_PASSWORD__

[livekit-aor]
type=aor
contact=sip:__LIVEKIT_SIP_HOST__:5060\;transport=tcp
qualify_frequency=0

[livekit-sip]
type=endpoint
transport=transport-tcp
context=from-livekit
disallow=all
allow=ulaw,alaw,opus
outbound_auth=livekit-auth
aors=livekit-aor
from_domain=__SIP_DOMAIN__
from_user=__AI_EXTENSION__
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
language=en
