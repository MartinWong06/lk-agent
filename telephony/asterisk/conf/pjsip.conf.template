; Generated at container start from env — do not edit the live file by hand.
; Softphone users register (via Kamailio) and dial AI extension → LiveKit SIP.

[global]
type=global
endpoint_identifier_order=username,ip,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=__EXTERNAL_SIP_IP__
external_signaling_address=__EXTERNAL_SIP_IP__

; LiveKit Cloud SIP expects TCP in many deployments
[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=__EXTERNAL_SIP_IP__
external_signaling_address=__EXTERNAL_SIP_IP__

; ---------- Softphone endpoint ----------
[__SOFTPHONE_USER__]
type=endpoint
context=from-internal
disallow=all
allow=ulaw,alaw,opus
auth=__SOFTPHONE_USER__
aors=__SOFTPHONE_USER__
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=yes
use_avpf=yes
media_encryption=dtls
dtls_auto_generate_cert=yes
dtls_verify=fingerprint
dtls_setup=actpass
rtcp_mux=yes

[__SOFTPHONE_USER__]
type=auth
auth_type=userpass
username=__SOFTPHONE_USER__
password=__SOFTPHONE_PASSWORD__

[__SOFTPHONE_USER__]
type=aor
max_contacts=5
remove_existing=yes
qualify_frequency=60

; ---------- LiveKit SIP trunk (outbound from Asterisk) ----------
[livekit-auth]
type=auth
auth_type=userpass
username=__LIVEKIT_SIP_USERNAME__
password=__LIVEKIT_SIP_PASSWORD__

[livekit-aor]
type=aor
contact=sip:__LIVEKIT_SIP_HOST__:5060\;transport=tcp
; Disable OPTIONS qualify — Cloud SIP may not answer OPTIONS from NAT’d peers
qualify_frequency=0

[livekit-sip]
type=endpoint
transport=transport-tcp
context=from-livekit
disallow=all
allow=ulaw,alaw,opus
outbound_auth=livekit-auth
aors=livekit-aor
from_domain=__SIP_DOMAIN__
from_user=__AI_EXTENSION__
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
language=en
