[general]
; Narrow range for Docker Desktop UDP publish reliability (must match compose ports)
rtpstart=20000
rtpend=20050
icesupport=yes
strictrtp=no
bindaddr=0.0.0.0
; No stunaddr/turnaddr: unreachable STUN at boot/call time stalls PJSIP (408/503),
; and the [ice_host_candidates] override below must not be mixed with STUN/TURN.

; Browser WebRTC (Docker bridge): Asterisk only sees its container IP (172.x), which
; a browser on the host/LAN cannot reach. The entrypoint maps it to SOFTPHONE_MEDIA_IP
; so ICE targets the published RTP ports (20000-20050/udp) instead.
[ice_host_candidates]
__ICE_HOST_CANDIDATES__
