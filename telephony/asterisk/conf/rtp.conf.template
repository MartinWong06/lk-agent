[general]
; Narrow range for Docker Desktop UDP publish reliability
rtpstart=10000
rtpend=10050
icesupport=yes
strictrtp=no
bindaddr=0.0.0.0
; Do NOT point Asterisk stun/turn at coturn here.
; Unreachable STUN at boot / call time has caused flaky INVITE (408/503) on Desktop.
; Softphone SIP.js uses coturn iceServers; Asterisk answers browser relay candidates
; with media_address=SOFTPHONE_MEDIA_IP + webrtc/rtp_symmetric.
