[general]
; Narrower range = more reliable Docker Desktop UDP publish than 100 ports
rtpstart=10000
rtpend=10050
icesupport=yes
strictrtp=no
bindaddr=0.0.0.0
; Docker Desktop: browser↔Asterisk direct UDP is unreliable. Use coturn TURN so
; both sides relay via published LAN ports instead of hairpin NAT.
turnaddr=coturn:3478
turnusername=__TURN_USER__
turnpassword=__TURN_PASSWORD__
; Optional STUN via same coturn (no Google STUN — that timed out / poisoned ICE)
stunaddr=coturn:3478
