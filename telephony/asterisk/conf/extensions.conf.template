[general]
static=yes
writeprotect=no

[from-internal]
; Softphone dials __AI_EXTENSION__; Asterisk bridges to LiveKit DID on the inbound trunk
exten => __AI_EXTENSION__,1,NoOp(Routing to LiveKit duplex agent)
 same => n,Set(CALLERID(num)=${IF($[${LEN(${CALLERID(num)})}>0]?${CALLERID(num)}:1001)})
 same => n,Dial(PJSIP/__LIVEKIT_DID__@livekit-sip,120)
 same => n,Hangup()

; Echo test for media sanity
exten => 9196,1,Answer()
 same => n,Echo()
 same => n,Hangup()

[from-livekit]
exten => _X.,1,NoOp(Return from LiveKit ${EXTEN})
 same => n,Hangup()
